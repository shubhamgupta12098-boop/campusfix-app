PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/campusfix?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://campusfix-app.onrender.com,http://localhost,https://localhost,capacitor://localhost,ionic://localhost
ADMIN_EMAIL=admin@campusfix.local
ADMIN_PASSWORD=Admin@123

# Password reset email on Render Free (HTTPS API; no SMTP timeout)
RESEND_API_KEY=re_your_resend_api_key
# onboarding@resend.dev can initially send only to the email used for your Resend account.
# After verifying your domain, use e.g. CampusFix CCMMS <no-reply@yourdomain.com>.
RESEND_FROM=CampusFix CCMMS <onboarding@resend.dev>
MAIL_FROM=CampusFix CCMMS <onboarding@resend.dev>
APP_NAME=CampusFix CCMMS

# Optional SMTP fallback for local development or a host that permits SMTP ports.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
