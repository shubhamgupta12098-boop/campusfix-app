MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/campusfix?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173,https://your-frontend.onrender.com
PORT=5000

# Session tokens (login/signup). Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Used ONLY for the "forgot password" email flow (sending reset emails +
# verifying reset codes). Signup/login/passwords all live in MongoDB.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
# Where the reset-password link in the email should point. Must also be set as the
# "action URL" in Firebase Console > Authentication > Templates > Password reset.
RESET_PASSWORD_URL=https://your-frontend.onrender.com

ADMIN_EMAIL=admin@your-campus.edu
ADMIN_PASSWORD=change-this-password
