# Copy this file to .env for local testing. Never commit real secrets.
NODE_ENV=development
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# MongoDB Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/ccmms?retryWrites=true&w=majority&appName=CCMMS
MONGODB_DB=ccmms

# Primary password-reset delivery: Firebase Authentication Web API key.
# Firebase Console > Authentication > Sign-in method > enable Email/Password.
# Use Project settings > General > Web API Key (usually starts with AIza).
FIREBASE_API_KEY=

# Optional SMTP fallback when Firebase email delivery/configuration fails.
# Gmail example: smtp.gmail.com / 465 / true + a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESET_TOKEN_MINUTES=30

# Render detects RENDER_EXTERNAL_URL automatically. Usually leave these empty.
APP_BASE_URL=
CORS_ORIGINS=

# Creates/updates the first Admin account at server startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=CCMMS Admin

SEED_DEMO_USERS=false
ALLOW_ADMIN_SIGNUP=false
