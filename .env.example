# CCMMS Render / production environment template
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string. Keep the real value only in Render Environment.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/ccmms?retryWrites=true&w=majority

# Firebase Web API key — used ONLY for Forgot Password.
FIREBASE_API_KEY=

# Optional. Render automatically provides RENDER_EXTERNAL_URL, so this can stay blank.
APP_BASE_URL=

# Keep blank for same-origin Render deployment.
CORS_ORIGINS=

# Production bootstrap admin. Configure these as Render secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CCMMS Admin

# Safer production defaults.
SEED_DEMO_USERS=false
ALLOW_ADMIN_SIGNUP=false
