# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ccmms

# Firebase Authentication - ONLY used for Forgot Password.
# Firebase Console -> Project settings -> General -> Web API Key
# Also enable Authentication -> Sign-in method -> Email/Password.
FIREBASE_API_KEY=

# Public app URL. On Render set this to https://your-service.onrender.com
# Add the same Render domain to Firebase Authentication -> Settings -> Authorized domains.
APP_BASE_URL=http://localhost:3000

# CORS. Same-origin production does not need extra origins.
# For Vite dev servers you can keep these defaults.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Demo accounts are seeded when the DB is empty.
SEED_DEMO_USERS=true
ALLOW_ADMIN_SIGNUP=false
