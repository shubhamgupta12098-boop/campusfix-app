#!/bin/sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "${JAVA_HOME:-}" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
  if [ ! -x "$JAVA_EXE" ]; then
    echo "ERROR: JAVA_HOME points to an invalid Java installation: $JAVA_HOME" >&2
    exit 1
  fi
else
  JAVA_EXE=$(command -v java || true)
  if [ -z "$JAVA_EXE" ]; then
    echo "ERROR: Java was not found. Install JDK 17+ or set JAVA_HOME." >&2
    exit 1
  fi
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "ERROR: Missing $WRAPPER_JAR" >&2
  exit 1
fi

exec "$JAVA_EXE" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
